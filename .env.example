# Local Environment Configuration
# Copy this file to .env and adjust values as needed.
# Do NOT commit your actual .env file to version control.

# Directory Paths (relative to project root or absolute paths)
DATA_DIR=data
CONFIG_DIR=configs
MODEL_SAVE_DIR=experiment/models/saved
RESULTS_DIR=experiment/results
LOG_DIR=logs

# Execution & Reproducibility Settings
RANDOM_SEED=42
DEVICE=auto

# Optional API Credentials (e.g., for TabPFN client backend)
TABPFN_TOKEN=your_prior_labs_token_here
